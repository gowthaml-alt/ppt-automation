# Copy to .env and fill in. Never commit .env.

APP_ENV=staging
LOG_LEVEL=INFO
# text = one readable line per event in the terminal. json = the old format.
# The log file stays JSON either way.
LOG_CONSOLE_FORMAT=text

# PHP nuSource API. This worker only talks HTTP — it never connects to MySQL.
# BASE is {API_HOST}/nuSource/api/v1
BACKEND_BASE_URL=https://hello.edupanion.com/nuSource/api/v1

# Queue password is hardcoded in api_client.jobs.WORKER_TOKEN.
# Sent as ?token= on GET /next and inside JSONString on POST /result.
# Optional extra: X-PPT-WORKER-TOKEN. No user session. No APIKEY.

POLL_INTERVAL_SECONDS=30
GET_JOB_RETRY_ATTEMPTS=3
CALLBACK_RETRY_ATTEMPTS=3

# Both must exist and be writable, or the worker refuses to start.
# LOG_ROOT is not just logs: the health file that stops a broken worker
# after three failures in a row lives there too.
TEMP_ROOT=C:\ppt-automation\jobs
LOG_ROOT=C:\ppt-automation\logs
KEEP_FAILED_JOB_FILES=false
MIN_FREE_DISK_GB=10

MAX_PPT_SIZE_MB=500

DOWNLOAD_TIMEOUT_SECONDS=300
POWERPOINT_START_TIMEOUT_SECONDS=60
POWERPOINT_OPEN_TIMEOUT_SECONDS=120
ISPRING_PUBLISH_TIMEOUT_SECONDS=1800
UPLOAD_TIMEOUT_SECONDS=600
BACKEND_REQUEST_TIMEOUT_SECONDS=60
SLACK_REQUEST_TIMEOUT_SECONDS=15
BROWSER_TEST_TIMEOUT_SECONDS=60
BROWSER_TEST_ENABLED=true

SLACK_WEBHOOK_URL=

POWERPOINT_EXE_PATH=
ISPRING_INSTALL_PATH=
POWERPOINT_KILL_ORPHANS=false
POWERPOINT_ORPHAN_MAX_AGE_SECONDS=3600

# not_configured | fake | uia. Real publishing needs uia.
ISPRING_ADAPTER=uia

# The folders in iSpring Cloud holding one folder per institution. Both are
# searched. The first one listed wins when a name exists under both.
ISPRING_PARENT_FOLDERS=PPT Migration,PPT migration New
# Where a folder is made for an institution that has none.
ISPRING_NEW_INSTITUTION_PARENT=PPT migration New

# Chrome the share step attaches to. Start it with
# scripts\start_ispring_chrome.cmd and sign in to iSpring Cloud once.
ISPRING_CHROME_CDP_URL=http://127.0.0.1:9222

# Browser dumps. A failed share step always writes one; set ISPRING_DUMP=1 to
# write one on every run as well. They land in .\test-artifacts unless
# ISPRING_DUMP_DIR says otherwise.
ISPRING_DUMP=
ISPRING_DUMP_DIR=

# Seconds to wait after PowerPoint says publishing is complete, while iSpring
# finishes uploading to the cloud.
ISPRING_UPLOAD_WAIT=15

# How long to keep looking for the institution in the publish dialog's project
# picker. The tree loads its folders after a branch opens, and the two parents
# hold hundreds, so a single look can read a tree that is still filling in.
ISPRING_PICKER_WAIT=45

STORAGE_BACKEND=local_fs

# Empty allowlist permits any host (needed for signed download URLs).
DOWNLOAD_ALLOWED_HOSTS=

S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KEY_PREFIX=
S3_PUBLIC_BASE_URL=

LOCAL_STORAGE_ROOT=
LOCAL_STORAGE_PUBLIC_BASE_URL=
