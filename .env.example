# Copy to .env and fill in. Never commit .env.

APP_ENV=development
LOG_LEVEL=INFO

# Node.js backend. This worker only talks HTTP — it never connects to MySQL.
BACKEND_BASE_URL=https://backend.example.com
BACKEND_GET_JOB_PATH=/api/ppt-jobs/next
BACKEND_CALLBACK_PATH=/api/ppt-jobs/callback

# Optional. Send this header on GET/callback only if the backend requires it.
BACKEND_API_KEY=
BACKEND_API_KEY_HEADER=X-API-Key

POLL_INTERVAL_SECONDS=30
GET_JOB_RETRY_ATTEMPTS=3
CALLBACK_RETRY_ATTEMPTS=3

TEMP_ROOT=D:\ppt-automation\jobs
LOG_ROOT=D:\ppt-automation\logs
KEEP_FAILED_JOB_FILES=false
MIN_FREE_DISK_GB=10

MAX_PPT_SIZE_MB=500

DOWNLOAD_TIMEOUT_SECONDS=300
POWERPOINT_START_TIMEOUT_SECONDS=60
POWERPOINT_OPEN_TIMEOUT_SECONDS=120
ISPRING_PUBLISH_TIMEOUT_SECONDS=1800
UPLOAD_TIMEOUT_SECONDS=600
BACKEND_REQUEST_TIMEOUT_SECONDS=60
SLACK_REQUEST_TIMEOUT_SECONDS=15
BROWSER_TEST_TIMEOUT_SECONDS=60
BROWSER_TEST_ENABLED=true

SLACK_WEBHOOK_URL=

POWERPOINT_EXE_PATH=
ISPRING_INSTALL_PATH=
POWERPOINT_KILL_ORPHANS=false
POWERPOINT_ORPHAN_MAX_AGE_SECONDS=3600

# not_configured | fake | vba | uia | cli
# Stays not_configured until scripts/probe_ispring.py is run on the Cloud PC.
ISPRING_ADAPTER=not_configured

# local_fs | s3 | http_api
# local_fs is refused when APP_ENV=production.
STORAGE_BACKEND=local_fs

# Empty allowlist permits any host (needed for S3 presigned URLs).
DOWNLOAD_ALLOWED_HOSTS=

S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KEY_PREFIX=
S3_PUBLIC_BASE_URL=

LOCAL_STORAGE_ROOT=
LOCAL_STORAGE_PUBLIC_BASE_URL=
