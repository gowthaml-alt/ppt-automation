# Copy to .env and fill in. Never commit .env.

APP_ENV=development
LOG_LEVEL=INFO

# PHP nuSource API. This worker only talks HTTP — it never connects to MySQL.
# BASE is {API_HOST}/nuSource/api/v1
BACKEND_BASE_URL=https://api.example.com/nuSource/api/v1

# Queue password is hardcoded in api_client.jobs.WORKER_TOKEN.
# Sent as ?token= on GET /next and inside JSONString on POST /result.
# Optional extra: X-PPT-WORKER-TOKEN. No user session. No APIKEY.

POLL_INTERVAL_SECONDS=30
GET_JOB_RETRY_ATTEMPTS=3
CALLBACK_RETRY_ATTEMPTS=3

TEMP_ROOT=D:\ppt-automation\jobs
LOG_ROOT=D:\ppt-automation\logs
KEEP_FAILED_JOB_FILES=false
MIN_FREE_DISK_GB=10

MAX_PPT_SIZE_MB=500

DOWNLOAD_TIMEOUT_SECONDS=300
POWERPOINT_START_TIMEOUT_SECONDS=60
POWERPOINT_OPEN_TIMEOUT_SECONDS=120
ISPRING_PUBLISH_TIMEOUT_SECONDS=1800
UPLOAD_TIMEOUT_SECONDS=600
BACKEND_REQUEST_TIMEOUT_SECONDS=60
SLACK_REQUEST_TIMEOUT_SECONDS=15
BROWSER_TEST_TIMEOUT_SECONDS=60
BROWSER_TEST_ENABLED=true

SLACK_WEBHOOK_URL=

POWERPOINT_EXE_PATH=
ISPRING_INSTALL_PATH=
POWERPOINT_KILL_ORPHANS=false
POWERPOINT_ORPHAN_MAX_AGE_SECONDS=3600

# not_configured | fake | uia
ISPRING_ADAPTER=not_configured

# Folder in iSpring Cloud holding one project per institution.
ISPRING_PARENT_FOLDER=PPT Migration

# Chrome the share step attaches to. Start it with
# scripts\start_ispring_chrome.cmd and sign in to iSpring Cloud once.
ISPRING_CHROME_CDP_URL=http://127.0.0.1:9222

# Browser dumps. A failed share step always writes one; set ISPRING_DUMP=1 to
# write one on every run as well. They land in .\test-artifacts unless
# ISPRING_DUMP_DIR says otherwise.
ISPRING_DUMP=
ISPRING_DUMP_DIR=

# Seconds to wait after PowerPoint says publishing is complete, while iSpring
# finishes uploading to the cloud.
ISPRING_UPLOAD_WAIT=15

STORAGE_BACKEND=local_fs

# Empty allowlist permits any host (needed for signed download URLs).
DOWNLOAD_ALLOWED_HOSTS=

S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KEY_PREFIX=
S3_PUBLIC_BASE_URL=

LOCAL_STORAGE_ROOT=
LOCAL_STORAGE_PUBLIC_BASE_URL=
